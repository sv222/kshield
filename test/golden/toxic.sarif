{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "kshield",
          "version": "0.0.0-deterministic",
          "rules": [
            {
              "id": "KS-WL-001",
              "name": "DORA-CH2-001",
              "shortDescription": {
                "text": "Container may run as root (no runAsNonRoot: true, or UID 0)"
              },
              "properties": {
                "tags": [
                  "patch",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-WL-002",
              "name": "DORA-CH2-002",
              "shortDescription": {
                "text": "privileged: true or allowPrivilegeEscalation not false"
              },
              "properties": {
                "tags": [
                  "patch",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-WL-003",
              "name": "DORA-CH2-003",
              "shortDescription": {
                "text": "Capabilities not dropped (drop: [ALL] missing)"
              },
              "properties": {
                "tags": [
                  "patch",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-WL-004",
              "name": "DORA-CH2-004",
              "shortDescription": {
                "text": "hostIPC, hostPID or hostNetwork true"
              },
              "properties": {
                "tags": [
                  "patch",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-WL-005",
              "name": "DORA-CH2-005",
              "shortDescription": {
                "text": "/dev/shm from hostPath (or hostPath /dev)"
              },
              "properties": {
                "tags": [
                  "patch",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-WL-006",
              "name": "DORA-CH2-006",
              "shortDescription": {
                "text": "Memory emptyDir for shm without sizeLimit"
              },
              "properties": {
                "tags": [
                  "patch",
                  "warn"
                ]
              }
            },
            {
              "id": "KS-WL-007",
              "name": "DORA-CH2-007",
              "shortDescription": {
                "text": "shareProcessNamespace: true on AI workload"
              },
              "properties": {
                "tags": [
                  "patch",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-WL-008",
              "name": "DORA-CH2-008",
              "shortDescription": {
                "text": "Root filesystem writable"
              },
              "properties": {
                "tags": [
                  "patch",
                  "warn"
                ]
              }
            },
            {
              "id": "KS-WL-009",
              "name": "DORA-CH2-009",
              "shortDescription": {
                "text": "No seccompProfile: RuntimeDefault"
              },
              "properties": {
                "tags": [
                  "patch",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-WL-010",
              "name": "DORA-CH2-010",
              "shortDescription": {
                "text": "Service account token auto-mounted"
              },
              "properties": {
                "tags": [
                  "patch",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-WL-011",
              "name": "DORA-CH2-011",
              "shortDescription": {
                "text": "Secret values in plain env (HF_TOKEN, API keys)"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-WL-012",
              "name": "DORA-CH2-012",
              "shortDescription": {
                "text": "Image not pinned by digest"
              },
              "properties": {
                "tags": [
                  "manual",
                  "warn"
                ]
              }
            },
            {
              "id": "KS-WL-013",
              "name": "DORA-CH2-013",
              "shortDescription": {
                "text": "No memory limit on AI workload"
              },
              "properties": {
                "tags": [
                  "manual",
                  "warn"
                ]
              }
            },
            {
              "id": "KS-WL-014",
              "name": "DORA-CH2-014",
              "shortDescription": {
                "text": "GPU access via hostPath /dev/nvidia* or privileged, not device plugin"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-AI-001",
              "name": "DORA-CH2-015",
              "shortDescription": {
                "text": "vLLM API without auth (--api-key / VLLM_API_KEY unset)"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-AI-002",
              "name": "DORA-CH2-016",
              "shortDescription": {
                "text": "vLLM --trust-remote-code set"
              },
              "properties": {
                "tags": [
                  "patch",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-AI-003",
              "name": "DORA-CH2-017",
              "shortDescription": {
                "text": "Model load may use pickle"
              },
              "properties": {
                "tags": [
                  "patch",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-AI-004",
              "name": "DORA-CH2-018",
              "shortDescription": {
                "text": "Inference API exposed outside cluster (Service LoadBalancer/NodePort, Ingress) without auth"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-AI-005",
              "name": "DORA-CH2-019",
              "shortDescription": {
                "text": "Ray GCS 6379, client 10001 or dashboard 8265 exposed beyond ClusterIP"
              },
              "properties": {
                "tags": [
                  "patch",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-AI-006",
              "name": "DORA-CH2-020",
              "shortDescription": {
                "text": "Ray TLS off (RAY_USE_TLS not 1)"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-AI-007",
              "name": "DORA-CH2-021",
              "shortDescription": {
                "text": "Ollama 11434 exposed without an auth proxy"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-AI-008",
              "name": "DORA-CH2-022",
              "shortDescription": {
                "text": "Qdrant without API key or TLS"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-AI-009",
              "name": "DORA-CH2-023",
              "shortDescription": {
                "text": "Milvus authorization disabled"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-NET-001",
              "name": "DORA-CH2-024",
              "shortDescription": {
                "text": "AI namespace has no default-deny egress (no CNP/NetworkPolicy in input or cluster)"
              },
              "properties": {
                "tags": [
                  "policy",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-NET-002",
              "name": "DORA-CH2-025",
              "shortDescription": {
                "text": "Egress allow-list too broad (world, 0.0.0.0/0)"
              },
              "properties": {
                "tags": [
                  "policy",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-NET-003",
              "name": "DORA-CH2-026",
              "shortDescription": {
                "text": "Pod-to-pod encryption off (Cilium WireGuard/IPsec)"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-RT-001",
              "name": "DORA-CH2-027",
              "shortDescription": {
                "text": "No runtime shell-exec guard on AI namespace (Tetragon)"
              },
              "properties": {
                "tags": [
                  "policy",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-RT-002",
              "name": "DORA-CH2-028",
              "shortDescription": {
                "text": "No runtime egress-connect guard on AI namespace (Tetragon)"
              },
              "properties": {
                "tags": [
                  "policy",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-RT-003",
              "name": "DORA-CH2-029",
              "shortDescription": {
                "text": "No admission guard for root, host namespaces, shm hostPath, pickle load (Kyverno)"
              },
              "properties": {
                "tags": [
                  "policy",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-PRE-001",
              "name": "DORA-CH2-030",
              "shortDescription": {
                "text": "Tetragon missing or unhealthy"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-PRE-002",
              "name": "DORA-CH2-031",
              "shortDescription": {
                "text": "CNI is not Cilium (L7/FQDN egress not possible)"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-PRE-003",
              "name": "DORA-CH2-032",
              "shortDescription": {
                "text": "Kyverno missing or unhealthy"
              },
              "properties": {
                "tags": [
                  "manual",
                  "fail"
                ]
              }
            },
            {
              "id": "KS-PRE-004",
              "name": "DORA-CH2-033",
              "shortDescription": {
                "text": "Node kernel lacks BPF LSM (--node-probe)"
              },
              "properties": {
                "tags": [
                  "manual",
                  "warn"
                ]
              }
            }
          ]
        }
      },
