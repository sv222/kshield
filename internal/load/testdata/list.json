{
  "apiVersion": "v1",
  "kind": "List",
  "metadata": {
    "resourceVersion": ""
  },
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "vllm",
        "namespace": "ai-inference"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "vllm"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "vllm"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "vllm",
                "image": "vllm/vllm-openai:v0.6.3"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "vllm",
        "namespace": "ai-inference"
      },
      "spec": {
        "ports": [
          {
            "port": 8000,
            "targetPort": 8000
          }
        ],
        "selector": {
          "app": "vllm"
        }
      }
    }
  ]
}
